BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
ADMIN_ID=0
ADMIN_USERNAME=
UZCARD=
HUMO=
CARD_HOLDER=
# Business auto-replies require connecting this bot to the admin account in Telegram Business.
BUSINESS_AUTOREPLY=1
TERMINAL_INSTRUCTIONS=
# Optional approved localized HD banners. Leave blank to keep the original artwork.
BANNER_FILE_ID_UZ=
BANNER_FILE_ID_RU=
BANNER_URL_UZ=
BANNER_URL_RU=
# HTTPS Mini App URL (also used for API CORS).
MINIAPP_URL=
# Merchant price: UZS of service value per Star. Set your own rate.
# 0 disables new Stars invoices until configured.
STARS_RATE_UZS=0
ENABLE_HTTP=1
HTTP_PORT=8080
# For a separately hosted frontend: its origin, without a trailing path.
ALLOWED_ORIGIN=
# Optional persistent database path. Default: ./orders.sqlite3
DB_PATH=
